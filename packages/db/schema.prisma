generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextIndex"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

type ProfessorsCourses {
  courseID         String
  overallRating    Float
  semesters        ProfessorsCoursesSemesters[]
  summerHrsPerWeek Float?
  teachingRating   Float
  yearHrsPerWeek   Float?
}

type ProfessorsCoursesSemesters {
  semester String
  year     String
}

type SchedulesLectures {
  id          String                   @map("_id") @db.ObjectId
  instructors String[]
  location    String?
  name        String
  times       SchedulesLecturesTimes[]
}

type SchedulesLecturesTimes {
  id       String  @map("_id") @db.ObjectId
  begin    String
  building String?
  days     Int[]
  end      String
  room     String?
}

type SchedulesSections {
  id          String                   @map("_id") @db.ObjectId
  instructors String[]
  lecture     String?
  location    String?
  name        String
  times       SchedulesSectionsTimes[]
}

type SchedulesSectionsTimes {
  id       String  @map("_id") @db.ObjectId
  begin    String
  building String?
  days     Int[]
  end      String
  room     String?
}

model courses {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  v            Int?        @map("__v")
  coreqs       String[]
  courseID     String      @unique
  crosslisted  String[]
  department   String
  desc         String
  name         String
  prereqString String
  prereqs      String[]
  units        String
  schedules    schedules[]

  @@fulltext([courseID, name, department, desc, prereqString], map: "text")
}

model fces {
  id                  String  @id @default(auto()) @map("_id") @db.ObjectId
  v                   Int     @map("__v")
  andrewID            String?
  college             String
  courseID            String
  courseName          String
  department          String
  hrsPerWeek          Float
  instructor          String
  level               String
  location            String?
  numRespondents      Int
  possibleRespondents Int
  rating              Float[]
  responseRate        String
  semester            String
  year                String

  @@index([instructor], map: "instructor")
  @@index([courseID], map: "courseID_1_autocreated")
}

model professors {
  id                 String              @id @default(auto()) @map("_id") @db.ObjectId
  andrewID           String?
  courses            ProfessorsCourses[]
  departments        String[]
  interestInLearning Float
  name               String
  providesFeedback   Float
  respectForStudents Float

  @@fulltext([name], map: "name_text")
}

model schedules {
  id          String              @id @default(auto()) @map("_id") @db.ObjectId
  v           Int?                @map("__v")
  courseID    String
  lectures    SchedulesLectures[]
  sections    SchedulesSections[]
  instructors String[]
  semester    String
  session     String?
  year        Int
  courses     courses             @relation(fields: [courseID], references: [courseID])

  @@index([courseID], map: "courseID_1")
  @@index([instructors], map: "instructors")
}

enum RatingTargetType {
  COURSE
  INSTRUCTOR
}

model ratings {
  id              String           @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId     String
  targetType      RatingTargetType
  /// courseID for COURSE, instructor name string for INSTRUCTOR (professors have no stable id
  /// anywhere in this codebase - fces.instructor and schedules.instructors are both free-text names)
  targetID        String
  stars           Int
  comment         String?
  /// courses only; UI-hidden for INSTRUCTOR, not schema-rejected
  wishIKnew       String?
  /// Optional 1-5 answers alongside `stars`. workload is a course-only question (1 light, 5 heavy);
  /// documents written before these existed simply lack the fields and read back as null.
  workload        Int?
  gradingFairness Int?
  transparency    Int?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([clerkUserId, targetType, targetID])
  @@index([targetType, targetID])
}

model geneds {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  v              Int      @map("__v")
  courseID       String
  school         String
  tags           String[]
  startsCounting String?
  stopsCounting  String?
}

// User profiles. Validation rules and taxonomy ids live in @cmucourses/profile.

enum Modality {
  IN_PERSON
  REMOTE
  HYBRID
}

enum CourseStatus {
  TAKEN
  IN_PROGRESS
}

enum DegreeLevel {
  UNDERGRAD
  MASTERS
  PHD
}

enum Visibility {
  PUBLIC
  PRIVATE
}

type ProfilesAcademic {
  college      String?
  majors       String[]
  minors       String[]
  degree       DegreeLevel?
  gradSemester String?
  gradYear     Int?
}

type ProfilesWorkload {
  unitsMin     Int?
  unitsMax     Int?
  hoursPerWeek Int?
}

type ProfilesBusyBlocks {
  /// 0 = Sunday ... 6 = Saturday
  day   Int
  /// minutes after midnight
  begin Int
  end   Int
  label String?
}

type ProfilesSchedulePreferences {
  earliestStart Int?
  latestEnd     Int?
  preferredDays Int[]
  compactDays   Boolean
}

type ProfilesCourses {
  courseID String
  status   CourseStatus
  semester String?
  year     String?
}

type ProfilesPlannedCourses {
  courseID String
  semester String
  year     String
}

type ProfilesVisibility {
  academic   Visibility @default(PRIVATE)
  careers    Visibility @default(PRIVATE)
  skills     Visibility @default(PRIVATE)
  courses    Visibility @default(PRIVATE)
  /// whether Circles posts show what each busy time is for (times always show)
  busyLabels Visibility @default(PRIVATE)
}

type ProfilesSavedSession {
  year     String
  semester String
  /// "summer one" | "summer two" | "summer all"; only on a summer
  session  String?
}

/// The catalog search filters kept as the student's default. Private to them: never in social output.
type ProfilesSavedFilters {
  departments     String[]
  unitsMin        Int?
  unitsMax        Int?
  sessions        ProfilesSavedSession[]
  /// hundreds digit of the course number: 0 for 0xx ... 9 for 9xx
  levels          Int[]
  classTimes      String[]
  meetingDays     Int[]
  timeBegin       Int?
  timeEnd         Int?
  fitAvailability Boolean
  matchGoals      Boolean
}

model profiles {
  id                  String                       @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId         String                       @unique
  displayName         String?
  bio                 String?
  /// ordered by priority
  careers             String[]
  skillsHave          String[]
  skillsWant          String[]
  academic            ProfilesAcademic?
  workload            ProfilesWorkload?
  modality            Modality?
  busyBlocks          ProfilesBusyBlocks[]
  schedulePreferences ProfilesSchedulePreferences?
  courses             ProfilesCourses[]
  plannedCourses      ProfilesPlannedCourses[]
  visibility          ProfilesVisibility
  savedFilters        ProfilesSavedFilters?
  /// starred courses (Saved); private
  savedCourses        String[]
  onboardedAt         DateTime?
  createdAt           DateTime                     @default(now())
  updatedAt           DateTime                     @updatedAt

  @@index([courses.courseID])
}

type CirclePostCourses {
  courseID String
  lecture  String?
  section  String?
}

model follows {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  followerUserId    String
  followedProfileId String   @db.ObjectId
  createdAt         DateTime @default(now())

  @@unique([followerUserId, followedProfileId])
  @@index([followedProfileId])
}

model directMessages {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  /// The two Clerk user ids, sorted and joined with ":". Server-only; never sent to clients.
  conversationKey String
  senderUserId    String
  recipientUserId String
  body            String
  createdAt       DateTime  @default(now())
  /// Set when the recipient opens the conversation.
  readAt          DateTime?

  @@index([conversationKey, createdAt])
  @@index([recipientUserId, readAt])
}

type SavedScheduleCourses {
  courseID String
  lecture  String?
  section  String?
}

/// A named schedule kept on the account (the builder's working copy stays in the browser).
model savedSchedules {
  id          String                 @id @default(auto()) @map("_id") @db.ObjectId
  clerkUserId String
  name        String
  semester    String
  year        String
  /// "summer one" | "summer two" | "summer all"; only on a summer
  session     String?
  courses     SavedScheduleCourses[]
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([clerkUserId, updatedAt])
}

/// One student's shared schedule for one semester (sharing again replaces it). Copied from a
/// saved schedule. The old socialSchedules / scheduleReactions / scheduleComments collections are
/// no longer read; scripts/demo/seed-circles.mjs --migrate-old moves their data here.
model circlePosts {
  id               String              @id @default(auto()) @map("_id") @db.ObjectId
  authorUserId     String
  name             String
  semester         String
  year             String
  session          String?
  courses          CirclePostCourses[]
  sourceScheduleId String?             @db.ObjectId
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  @@unique([authorUserId, semester, year])
  @@index([updatedAt])
}

model postReactions {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  reactorUserId String
  postId        String   @db.ObjectId
  reaction      String
  updatedAt     DateTime @updatedAt

  @@unique([reactorUserId, postId])
  @@index([postId])
}

model postComments {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  authorUserId String
  postId       String   @db.ObjectId
  body         String
  createdAt    DateTime @default(now())

  @@index([postId, createdAt])
}
