# Copy to .env in the repo root and fill in.

# --- Frontend ---
# Live backend. No trailing slash. Use http://localhost:3000 to run the backend locally.
NEXT_PUBLIC_BACKEND_URL="https://course.apis.scottylabs.org"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Optional analytics; the app runs without these.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Backend (only needed if you run apps/backend locally) ---
# Read by packages/db/schema.prisma.
MONGODB_URI=
PORT=3000
AUTH_ENABLED=false
CLERK_PEM_KEY=
CLERK_LOGIN_HOST=
BACKEND_ENV=development
